# ETAPA 14 - denoising/Inferência das ASVs

dadaFs <- dada(
  filtFs,
  err = errF,
  multithread = TRUE
)

dadaRs <- dada(
  filtRs,
  err = errR,
  multithread = TRUE
)

# ETAPA 15 - Merge das Leituras Paired-End

# 15.1 - Realizar o merge das leituras Forward e Reverse

mergers <- mergePairs(
  dadaFs,
  filtFs,
  dadaRs,
  filtRs,
  verbose = TRUE
)

# 15.2 - Função para calcular estatísticas de merge

merge_summary <- function(merger, sample_name) {
  
  merged_reads <- sum(merger$abundance)
  
  total_input <- out[sample_name, "reads.out"]
  
  taxa_merge <- ifelse(
    total_input > 0,
    round(merged_reads / total_input * 100, 2),
    NA
  )
  
  data.frame(
    Amostra      = sample_name,
    Reads_totais = total_input,
    Reads_unidas = merged_reads,
    Taxa_merge   = taxa_merge
  )
}

# 15.3 - Criar tabela consolidada dos merges

merge_table <- do.call(
  rbind,
  lapply(
    names(mergers),
    function(s) merge_summary(mergers[[s]], s)
  )
)

# 15.4 - Visualizar tabela

print(merge_table)

# 15.5 - Salvar tabela de merge

write.csv2(
  merge_table,
  file.path(
    resultados_dir,
    "merge_table.csv"
  ),
  row.names = FALSE
)

# 15.6 - Criar tabela de sequências (ASVs merged)

seqtab <- makeSequenceTable(mergers)

# 15.7 - Verificar dimensões da tabela

dim(seqtab)

# 15.8 - Verificar distribuição dos tamanhos das sequências

