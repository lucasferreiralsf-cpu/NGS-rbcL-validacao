### ANALISE NGS de amplicons ###

# ETAPA 1 - Instalação dos Pacotes (Caso o pacote ainda não tenha sido instalado)
install.packages("BiocManager")
BiocManager::install("dada2")
BiocManager::install("ShortRead")
install.packages(c("ggplot2","tidyverse","seqinr"))

# ETAPA 2 - Carregamento dos Pacotes
library(dada2)
library(ShortRead)
library(ggplot2)
library(tidyverse)
library(seqinr)

# ETAPA 3 - Diretório de Trabalho
path <- "/Users/Ferreira_/NGS-rbcL-validacao/INTECSO_18JUNHO2026_2026-06-18T17_17_51_6e9e5db-507459959/BCLConvert_Dragen16sPlus_06_19_2026_12_30_43Z-934455528"
dir.exists(path)
list.files(path)

# 3.1 Criar pasta de resultados
dir.create("resultados", showWarnings = FALSE)
dir.create("fastas_por_amostra", showWarnings = FALSE)

# ETAPA 4 - Identificação dos Arquivos Forward e Reverse
fnFs <- sort(list.files(path, pattern="_R1_001.fastq.gz$", full.names=TRUE))
fnRs <- sort(list.files(path, pattern="_R2_001.fastq.gz$", full.names=TRUE))

# ETAPA 5 - Avaliação Inicial da Qualidade
plotQualityProfile(fnFs)
png("resultados/quality_forward.png"); plotQualityProfile(fnFs); dev.off()
png("resultados/quality_reverse.png"); plotQualityProfile(fnRs); dev.off()

# ETAPA 6 - Quantificar Reads
reads_count <- sapply(fnFs, function(x) countFastq(x)$records)
reads_table <- data.frame(Sample=gsub("_S[0-9]+_L001.*","",basename(fnFs)), Reads=reads_count)
write.csv(reads_table,"resultados/reads_table.csv",row.names=FALSE)

# ETAPA 7 - Comprimento das Leituras
fq <- readFastq(fnFs[1])
table(width(sread(fq)))

# ETAPA 8 - Remoção de Adaptadores Illumina
# Esta etapa é fora do R, deve ser executada no terminal.
# Adaptadores (overhangs illumina) utilizados:
# Forward: TCGTCGGCAGCGTCAGATGTGTATAAGAGACAG
# Reverse: GTCTCGTGGGCTCGGAGATGTGTATAAGAGACAG

# pelo terminal, entrar na pasta onde estão localizadas as amostras e copiar o comando abaixo 
# Loop para remover adaptadores de todas as amostras
for f in *_R1_001.fastq.gz
do
base=$(echo $f | sed 's/_R1_001.fastq.gz//')
cutadapt \
-a TCGTCGGCAGCGTCAGATGTGTATAAGAGACAG \
-A GTCTCGTGGGCTCGGAGATGTGTATAAGAGACAG \
-o ${base}_trimmed_R1.fastq.gz \
-p ${base}_trimmed_R2.fastq.gz \
${base}_R1_001.fastq.gz \
${base}_R2_001.fastq.gz
done

# ETAPA 9 - Remoção dos Primers 
# Primers utilizados: rbcL
# Forward: ATGTCACCACAAACAGAGACTAAAGC
# Reverse: GTAAAATCAAGTCCACCRCG

# Ainda na pasta, copiar o comando abaixo
# Loop para remover primers de todas as amostras
for f in *_trimmed_R1.fastq.gz
do
base=$(echo $f | sed 's/_trimmed_R1.fastq.gz//')
cutadapt \
-g ATGTCACCACAAACAGAGACTAAAGC \
-G GTAAAATCAAGTCCACCRCG \
-o ${base}_primer_trimmed_R1.fastq.gz \
-p ${base}_primer_trimmed_R2.fastq.gz \
${base}_trimmed_R1.fastq.gz \
${base}_trimmed_R2.fastq.gz
done

# ETAPA 10 - Diretório de Arquivos Filtrados
filt_path <- file.path(path,"filtered"); dir.create(filt_path, showWarnings=FALSE)

# ETAPA 11 - Definir Arquivos Filtrados
filtFs <- file.path(filt_path, basename(fnFs))
filtRs <- file.path(filt_path, basename(fnRs))

# ETAPA 12 - Filtragem
out <- filterAndTrim(fnFs,filtFs,fnRs,filtRs,maxN=0,maxEE=c(2,2),truncQ=2,minLen=200,rm.phix=TRUE,compress=TRUE,multithread=TRUE)

# ETAPA 13 - Modelo de Erro
filtFs <- filtFs[file.exists(filtFs)]
filtRs <- filtRs[file.exists(filtRs)]
errF <- learnErrors(filtFs,multithread=TRUE)
errR <- learnErrors(filtRs,multithread=TRUE)
png("resultados/error_forward.png"); plotErrors(errF, nominalQ=TRUE); dev.off()
png("resultados/error_reverse.png"); plotErrors(errR, nominalQ=TRUE); dev.off()

# ETAPA 14 - Inferência das ASVs
dadaFs <- dada(filtFs, err=errF, multithread=TRUE)
dadaRs <- dada(filtRs, err=errR, multithread=TRUE)

# ETAPA 15 - Paired-End
# 15.1 Realizar o merge das leituras forward e reverse
mergers <- mergePairs(
  dadaFs,   # inferência forward
  filtFs,   # arquivos forward filtrados
  dadaRs,   # inferência reverse
  filtRs,   # arquivos reverse filtrados
  verbose = TRUE
)

# 15.2 Função para calcular estatísticas de merge
merge_summary <- function(merger, sample_name) {
  merged_reads <- sum(merger$abundance)
  
  # usar a coluna correta da tabela 'out' (reads após filtragem)
  total_input <- out[sample_name, "reads.out"]
  
  taxa_merge <- ifelse(total_input > 0,
                       round(merged_reads / total_input * 100, 2),
                       NA)
  
  data.frame(
    Amostra      = sample_name,
    Reads_totais = total_input,
    Reads_unidas = merged_reads,
    Taxa_merge   = taxa_merge
  )
}

# 15.3 Criar tabela consolidada de merges
merge_table <- do.call(rbind, lapply(names(mergers), function(s) {
  merge_summary(mergers[[s]], s)
}))

# 15.4 Visualizar e salvar tabela
print(merge_table)
write.csv(merge_table, "resultados/merge_table.csv", row.names = FALSE)

# 15.5 Criar sequence table para as ASVs
seqtab <- makeSequenceTable(mergers)

# 15.6 Verificar dimensões e tamanhos de sequência
dim(seqtab)
table(nchar(colnames(seqtab)))

# As ETAPAS 16 e 17 são opcionais e devem ser executadas apenas se a taxa de merge das leituras paired-end for insatisfatória. Nesse caso, a análise continua com as leituras forward (Single-End), garantindo que as ASVs sejam reconstruídas mesmo sem o pareamento completo.

# ETAPA 16 - Single-End (caso análise Paired-End fique com qualidade ruim)
seqtab_single <- makeSequenceTable(dadaFs)

# ETAPA 17 - Rastreamento Single-End
# 17.1 Função para contar reads únicos
getN <- function(x) sum(getUniques(x))

# 17.2 Garantir que 'out' tenha nomes de linha iguais às amostras
rownames(out) <- basename(fnFs)

# 17.3 Criar tabela de rastreamento completa
track_single <- data.frame(
  input     = out[,1],  # reads de entrada
  filtered  = out[,2],  # reads após filtragem
  denoisedF = NA,       # inicializa coluna
  ASVs      = NA        # inicializa coluna
)

# 17.4 Preencher apenas para amostras que passaram
for (s in names(dadaFs)) {
  track_single[s,"denoisedF"] <- getN(dadaFs[[s]])
  track_single[s,"ASVs"]      <- rowSums(seqtab_single[s, , drop=FALSE])
}

# 17.5 Visualizar e salvar tabela
print(track_single)
write.csv(track_single, "resultados/track_single.csv", row.names = TRUE)

# ETAPA 18 - Remoção de Quimeras
seqtab.nochim <- removeBimeraDenovo(seqtab,method="consensus",multithread=TRUE)

# ETAPA 19 - Comprimento das ASVs
asv.lengths <- nchar(colnames(seqtab.nochim))
png("resultados/asv_lengths_hist.png"); hist(asv.lengths,breaks=100,main="Comprimento das ASVs"); dev.off()

# ETAPA 20 - ASVs Mais Abundantes
asv.sum <- colSums(seqtab.nochim)
top20 <- head(sort(asv.sum,decreasing=TRUE),20)
write.csv(data.frame(ASV=names(top20),Abundancia=top20),"resultados/top20_asvs.csv",row.names=FALSE)

# ETAPA 21 - Exportação das ASVs em FASTA
seqs <- colnames(seqtab.nochim)
write.fasta(sequences=lapply(seqs,s2c),names=paste0("ASV_",seq_along(seqs)),file.out="resultados/ASVs_rbcL.fasta")

# 21.1 Exportar FASTA por amostra
for (sample in rownames(seqtab.nochim)) {
  sample_seqs <- seqtab.nochim[sample, ]
  sample_seqs <- sample_seqs[sample_seqs > 0]
  seqs_sample <- names(sample_seqs)
  write.fasta(sequences=lapply(seqs_sample,s2c),names=paste0("ASV_",seq_along(seqs_sample)),file.out=paste0("fastas_por_amostra/",sample,".fasta"))
}

# ETAPA 22 – Taxonomia por BLAST Local

# 22.1. Criar banco BLAST (Terminal)
cd /Users/Ferreira_/Downloads/rbcL_landPlant_v1-blastn
makeblastdb -in rbcL_landPlant.fasta -dbtype nucl -out rbcL_db

# 22.2 Rodar BLAST contra suas ASVs (Terminal)
blastn -query /Users/Ferreira_/NGS-rbcL-validacao/resultados/ASVs_rbcL.fasta \
-db /Users/Ferreira_/Downloads/rbcL_landPlant_v1-blastn/rbcL_db \
-out /Users/Ferreira_/NGS-rbcL-validacao/resultados/taxonomy.tsv \
-outfmt "6 qseqid sseqid pident length mismatch gapopen evalue bitscore staxids" \
-max_target_seqs 1

# 22.3 Importar resultados BLAST (R)
blast.results <- read.table("resultados/taxonomy.tsv", header=FALSE, sep="\t")
colnames(blast.results) <- c("ASV","RefSeq","PercIdentity","Length","Mismatch",
                             "GapOpen","Evalue","Bitscore","TaxID")

# 22.4 Selecionar melhor hit e extrair espécie
library(dplyr)
library(stringr)

best_hits <- blast.results %>%
  group_by(ASV) %>%
  slice_min(order_by = Evalue, n = 1) %>%
  mutate(species = str_extract(RefSeq, "[^;]+$"))

# 22.5 Juntar com abundância (seqtab.nochim gerado na ETAPA 18)
rownames(best_hits) <- best_hits$ASV

final_table <- as.data.frame(t(seqtab.nochim)) %>%
  mutate(species = best_hits[rownames(.), "species"])

# 22.6 Exportar tabela final
write.csv(final_table, "resultados/final_table_taxonomy.csv", row.names = TRUE)

