# ETAPA 4 - Identificação dos Arquivos Forward e Reverse
fnFs <- sort(list.files(path, pattern="_R1_001.fastq.gz$", full.names=TRUE))
fnRs <- sort(list.files(path, pattern="_R2_001.fastq.gz$", full.names=TRUE))

# ETAPA 5 - Avaliação Inicial da Qualidade
plotQualityProfile(fnFs)
plotQualityProfile(fnRs)

png(file.path(output_dir, "resultados/quality_forward.png")); plotQualityProfile(fnFs); dev.off()
png(file.path(output_dir, "resultados/quality_reverse.png")); plotQualityProfile(fnRs); dev.off()

# ETAPA 6 - Quantificar Reads
reads_count <- sapply(fnFs, function(x) countFastq(x)$records)
reads_table <- data.frame(Sample=gsub("_S[0-9]+_L001.*","",basename(fnFs)), Reads=reads_count)
write.csv2(reads_table, file.path(resultados_dir, "reads_table.csv"), row.names = FALSE)

# ETAPA 7 - Comprimento das Leituras
fq <- readFastq(fnFs[1])
table(width(sread(fq)))

# 7.1 Salva um histograma com o comprimento das leituras
png(
  file.path(resultados_dir, "read_lengths_histograma.png")
)

hist(
  width(sread(fq)),
  main = "Distribuição do comprimento das reads",
  xlab = "Comprimento (bp)"
)

dev.off()

# ETAPA 8 - Remoção dos Adaptadores Illumina
# Esta etapa deve ser executada fora do R utilizando o terminal do sistema operacional.
#
# Adaptadores (overhangs Illumina) utilizados:
# Forward (R1): TCGTCGGCAGCGTCAGATGTGTATAAGAGACAG
# Reverse (R2): GTCTCGTGGGCTCGGAGATGTGTATAAGAGACAG
#
# Navegar até o diretório contendo os arquivos FASTQ.
#
# WINDOWS
# Abrir a pasta onde estão localizados os FASTQs.
# Na barra de endereço do Windows Explorer, digitar:
# powershell
# e pressionar Enter.
#
# MACOS / LINUX
# Abrir o Terminal e acessar o diretório contendo os FASTQs.
#
# COMANDO PARA MACOS / LINUX

for f in *_R1_001.fastq.gz
do
base=$(echo $f | sed 's/_R1_001.fastq.gz//')

cutadapt \
-a TCGTCGGCAGCGTCAGATGTGTATAAGAGACAG \
-A GTCTCGTGGGCTCGGAGATGTGTATAAGAGACAG \
-o ${base}_trimmed_R1.fastq.gz \
-p ${base}_trimmed_R2.fastq.gz \
${base}_R1_001.fastq.gz \
${base}_R2_001.fastq.gz

done

# COMANDO PARA WINDOWS (PowerShell)

Get-ChildItem *_R1_001.fastq.gz | ForEach-Object {
  
  $base = $_.Name -replace "_R1_001.fastq.gz",""
  
  py -3.12 -m cutadapt `
  -a TCGTCGGCAGCGTCAGATGTGTATAAGAGACAG `
  -A GTCTCGTGGGCTCGGAGATGTGTATAAGAGACAG `
  -o "${base}_trimmed_R1.fastq.gz" `
  -p "${base}_trimmed_R2.fastq.gz" `
  "${base}_R1_001.fastq.gz" `
  "${base}_R2_001.fastq.gz"
  
}

# Ao término desta etapa serão gerados os arquivos:
# *_trimmed_R1.fastq.gz
# *_trimmed_R2.fastq.gz

# ETAPA 9 - Remoção dos Primers
# Esta etapa deve ser executada fora do R utilizando o terminal do sistema operacional.
#
# Primers utilizados (rbcL):
# Forward: ATGTCACCACAAACAGAGACTAAAGC
# Reverse: GTAAAATCAAGTCCACCRCG
#
# Permanecer no diretório contendo os FASTQs gerados na ETAPA 8.
#
# COMANDO PARA MACOS / LINUX

for f in *_trimmed_R1.fastq.gz
do
base=$(echo $f | sed 's/_trimmed_R1.fastq.gz//')

cutadapt \
-g ATGTCACCACAAACAGAGACTAAAGC \
-G GTAAAATCAAGTCCACCRCG \
-o ${base}_primer_trimmed_R1.fastq.gz \
-p ${base}_primer_trimmed_R2.fastq.gz \
${base}_trimmed_R1.fastq.gz \
${base}_trimmed_R2.fastq.gz

done

# COMANDO PARA WINDOWS (PowerShell)

Get-ChildItem *_trimmed_R1.fastq.gz | ForEach-Object {
  
  $base = $_.Name -replace "_trimmed_R1.fastq.gz",""
  
  py -3.12 -m cutadapt `
  -g ATGTCACCACAAACAGAGACTAAAGC `
  -G GTAAAATCAAGTCCACCRCG `
  -o "${base}_primer_trimmed_R1.fastq.gz" `
  -p "${base}_primer_trimmed_R2.fastq.gz" `
  "${base}_trimmed_R1.fastq.gz" `
  "${base}_trimmed_R2.fastq.gz"
  
}

# Ao término desta etapa serão gerados os arquivos:
# *_primer_trimmed_R1.fastq.gz
# *_primer_trimmed_R2.fastq.gz
#
# Estes arquivos serão utilizados como entrada para as etapas
# subsequentes do pipeline DADA2.

# ETAPA 10 - Diretório de Arquivos Filtrados
filt_path <- file.path(output_dir, "filtered")

dir.create(
  filt_path,
  showWarnings = FALSE
)

dir.exists(filt_path)

# ETAPA 11 - Definir Arquivos Filtrados

# 11.1 - Selecionar os FASTQs já tratados pelo Cutadapt

fnFs <- sort(
  list.files(
    path,
    pattern = "_primer_trimmed_R1.fastq.gz$",
    full.names = TRUE
  )
)

fnRs <- sort(
  list.files(
    path,
    pattern = "_primer_trimmed_R2.fastq.gz$",
    full.names = TRUE
  )
)

# Verificar quantidade de arquivos

length(fnFs)
length(fnRs)

# Verificar alguns nomes de arquivos

head(basename(fnFs))
head(basename(fnRs))

# Verificar se há o mesmo número de arquivos Forward e Reverse

stopifnot(length(fnFs) == length(fnRs))

# 11.2 - Definir os caminhos dos arquivos filtrados

filtFs <- file.path(
  filt_path,
  basename(fnFs)
)

filtRs <- file.path(
  filt_path,
  basename(fnRs)
)

# ETAPA 12 - Filtragem
out <- filterAndTrim(
  fnFs,
  filtFs,
  fnRs,
  filtRs,
  maxN = 0, #Remove qualquer read contendo bases indefinidas (N)
  maxEE = c(2,2), #Permite no máximo 2 erros esperados em R1 e R2
  truncQ = 2, #Trunca a read na primeira posição com qualidade ≤ 2
  minLen = 200, #Descarta reads menores que 200 bp após a filtragem
  rm.phix = TRUE, #Remove leituras provenientes do controle PhiX
  compress = TRUE, #Salva os FASTQs filtrados compactados (.gz)
  multithread = TRUE #Utiliza múltiplos núcleos do processador
)

out

# 12.1 - Salvar checkpoint da filtragem
saveRDS(
  list(
    path = path,
    output_dir = output_dir,
    resultados_dir = resultados_dir,
    r1_dir = r1_dir,
    r2_dir = r2_dir,
    merged_dir = merged_dir,
    filt_path = filt_path,
    fnFs = fnFs,
    fnRs = fnRs,
    filtFs = filtFs,
    filtRs = filtRs,
    out = out
  ),
  file.path(
    resultados_dir,
    "checkpoint_filtragem.rds"
  )
)

# 12.2 Salvar toda a sessão do R

save.image(
  file.path(
    resultados_dir,
    "workspace_filtragem.RData"
  )
)

