# ETAPA 20 - Exportação das ASVs em FASTA por amostra

# 20.1 Criar Sequence Tables para R1 e R2

seqtabF <- makeSequenceTable(dadaFs)
seqtabR <- makeSequenceTable(dadaRs)

# 20.2 Exportar FASTAs Merged por amostra

for (sample in rownames(seqtab.nochim)) {
  
  sample_seqs <- seqtab.nochim[sample, ]
  sample_seqs <- sample_seqs[sample_seqs > 0]
  
  seqs_sample <- names(sample_seqs)
  
  write.fasta(
    sequences = lapply(seqs_sample, s2c),
    names = paste0("ASV_", seq_along(seqs_sample)),
    file.out = file.path(
      merged_dir,
      paste0(sample, ".fasta")
    )
  )
  
}

# 20.3 Exportar FASTAs R1 por amostra

for (sample in rownames(seqtabF)) {
  
  sample_seqs <- seqtabF[sample, ]
  sample_seqs <- sample_seqs[sample_seqs > 0]
  
  seqs_sample <- names(sample_seqs)
  
  write.fasta(
    sequences = lapply(seqs_sample, s2c),
    names = paste0("ASV_", seq_along(seqs_sample)),
    file.out = file.path(
      r1_dir,
      paste0(sample, "_R1.fasta")
    )
  )
  
}

# 20.4 Exportar FASTAs R2 por amostra

for (sample in rownames(seqtabR)) {
  
  sample_seqs <- seqtabR[sample, ]
  sample_seqs <- sample_seqs[sample_seqs > 0]
  
  seqs_sample <- names(sample_seqs)
  
  write.fasta(
    sequences = lapply(seqs_sample, s2c),
    names = paste0("ASV_", seq_along(seqs_sample)),
    file.out = file.path(
      r2_dir,
      paste0(sample, "_R2.fasta")
    )
  )
  
}

# ETAPA 20.5 - Checkpoint Final Pré-BLAST

saveRDS(
  list(
