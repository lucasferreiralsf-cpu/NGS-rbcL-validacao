# ETAPA 16 - Single-End
# Executar apenas caso a taxa de merge do Paired-End seja insatisfatória

seqtab_single <- makeSequenceTable(dadaFs)

# ETAPA 17 - Rastreamento Single-End

# 17.1 Função para contar reads únicos

getN <- function(x) sum(getUniques(x))

# 17.2 Criar tabela apenas com amostras sobreviventes

track_single <- data.frame(
  Amostra  = names(dadaFs),
  input    = NA,
  filtered = NA,
  denoisedF = sapply(dadaFs, getN),
  ASVs      = rowSums(seqtab_single),
  row.names = NULL
)

# 17.3 Buscar valores correspondentes em 'out'

idx <- match(track_single$Amostra, rownames(out))

track_single$input    <- out[idx, "reads.in"]
track_single$filtered <- out[idx, "reads.out"]

# 17.4 Reorganizar colunas

track_single <- track_single[
  ,
  c(
    "Amostra",
    "input",
    "filtered",
    "denoisedF",
    "ASVs"
  )
]

# 17.5 Visualizar

print(track_single)

# 17.6 Salvar

write.csv2(
  track_single,
  file.path(
    resultados_dir,
    "track_single.csv"
  ),
  row.names = FALSE
)

# ETAPA 18 - Remoção de Quimeras

