# 3.1 Definir diretório de saída
output_dir <- "X:\\9. DESENVOLVIMENTO\\2026\\LUCAS\\4. VALIDAÇÕES EM ANDAMENTO - Biomol\\BM - Metodo identificacao taxonomica de especies vegetais - NGS\\8. DADOS BRUTOS"

